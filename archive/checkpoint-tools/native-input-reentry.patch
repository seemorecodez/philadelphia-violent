+void APhillyVehicle::ResetDriverInput()
+{
+    Throttle = 0;
+    Steering = 0;
+    bHandbrake = false;
+}
+
+void APhillyVehicle::PossessedBy(AController* NewController)
+{
+    ResetDriverInput();
+    Super::PossessedBy(NewController);
+}
+
+void APhillyVehicle::UnPossessed()
+{
+    // A key released while walking is delivered to the walker, not this pawn.
+    // Discard the outgoing driver's latched actions before another entry.
+    ResetDriverInput();
+    Super::UnPossessed();
+}
+
 void APhillyVehicle::SetupPlayerInputComponent(UInputComponent* Input)
 {
     Super::SetupPlayerInputComponent(Input);
